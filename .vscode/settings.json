{
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include/**",
    "${workspaceFolder}/src/**"
  ],
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
  "C_Cpp.autocomplete": "default",
  "C_Cpp.errorSquiggles": "enabled",
  "files.associations": {
    "*.hpp": "cpp",
    "*.h": "cpp",
    "*.tpp": "cpp",
    "array": "cpp",
    "string": "cpp",
    "string_view": "cpp",
    "vector": "cpp",
    "iostream": "cpp",
    "ostream": "cpp",
    "chrono": "cpp",
    "functional": "cpp",
    "tuple": "cpp",
    "atomic": "cpp",
    "bit": "cpp",
    "*.tcc": "cpp",
    "cctype": "cpp",
    "clocale": "cpp",
    "cmath": "cpp",
    "cstdarg": "cpp",
    "cstddef": "cpp",
    "cstdint": "cpp",
    "cstdio": "cpp",
    "cstdlib": "cpp",
    "cstring": "cpp",
    "ctime": "cpp",
    "cwchar": "cpp",
    "cwctype": "cpp",
    "deque": "cpp",
    "unordered_map": "cpp",
    "algorithm": "cpp",
    "memory": "cpp",
    "memory_resource": "cpp",
    "optional": "cpp",
    "fstream": "cpp",
    "initializer_list": "cpp",
    "iosfwd": "cpp",
    "istream": "cpp",
    "limits": "cpp",
    "new": "cpp",
    "random": "cpp",
    "sstream": "cpp",
    "stdexcept": "cpp",
    "system_error": "cpp",
    "type_traits": "cpp",
    "utility": "cpp"
  },
  "C_Cpp.inlayHints.autoDeclarationTypes.enabled": true,
  "C_Cpp.inlayHints.parameterNames.enabled": true
}